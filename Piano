import math
import sys
import numpy as np
import pygame

# Инициализация Pygame и аудиомикшера
pygame.init()
pygame.mixer.init(frequency=44100, size=-16, channels=1, buffer=512)

# Размеры окна
WIDTH, HEIGHT = 900, 500
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Функціональне піаніно на Python 🎹")

# Цвета
BG_COLOR = (18, 18, 22)
WHITE_KEY_COLOR = (245, 245, 245)
WHITE_KEY_PRESSED = (200, 200, 200)
BLACK_KEY_COLOR = (25, 25, 30)
BLACK_KEY_PRESSED = (70, 70, 80)
TEXT_COLOR = (180, 180, 190)
KEY_TEXT_COLOR = (40, 40, 40)
BLACK_KEY_TEXT_COLOR = (220, 220, 220)
SLIDER_BG = (40, 40, 50)
SLIDER_FILL = (80, 160, 240)
SLIDER_KNOB = (220, 220, 230)

# Громкость по умолчанию (от 0.0 до 1.0)
volume = 0.7

# Генерация звука
def generate_tone(frequency, duration=1.5, sample_rate=44100):
    n_samples = int(sample_rate * duration)
    t = np.linspace(0, duration, n_samples, False)

    wave = 0.6 * np.sin(2 * np.pi * frequency * t)
    wave += 0.25 * np.sin(2 * np.pi * frequency * 2 * t)
    wave += 0.15 * np.sin(2 * np.pi * frequency * 3 * t)

    decay = np.exp(-3 * t / duration)
    wave = wave * decay

    audio = (wave * 32767).astype(np.int16)
    return pygame.mixer.Sound(buffer=audio.tobytes())

# Ноты
NOTE_FREQS = {
    "C4": 261.63, "C#4": 277.18, "D4": 293.66, "D#4": 311.13, "E4": 329.63,
    "F4": 349.23, "F#4": 369.99, "G4": 392.00, "G#4": 415.30, "A4": 440.00,
    "A#4": 466.16, "B4": 493.88, "C5": 523.25, "C#5": 554.37, "D5": 587.33,
    "D#5": 622.25, "E5": 659.25, "F5": 698.46, "F#5": 739.99, "G5": 783.99,
    "G#5": 830.61, "A5": 880.00, "A#5": 932.33, "B5": 987.77,
}

sounds = {note: generate_tone(freq) for note, freq in NOTE_FREQS.items()}

# Привязка клавиш
KEY_MAP_WHITE = {
    pygame.K_a: "C4", pygame.K_s: "D4", pygame.K_d: "E4", pygame.K_f: "F4",
    pygame.K_g: "G4", pygame.K_h: "A4", pygame.K_j: "B4", pygame.K_k: "C5",
    pygame.K_l: "D5", pygame.K_SEMICOLON: "E5", pygame.K_QUOTE: "F5",
}

KEY_MAP_BLACK = {
    pygame.K_w: "C#4", pygame.K_e: "D#4", pygame.K_t: "F#4",
    pygame.K_y: "G#4", pygame.K_u: "A#4", pygame.K_o: "C#5", pygame.K_p: "D#5",
}

# Геометрия клавиш
WHITE_NOTES = ["C4", "D4", "E4", "F4", "G4", "A4", "B4", "C5", "D5", "E5", "F5", "G5", "A5", "B5"]
BLACK_POSITIONS = {
    "C#4": 0, "D#4": 1, "F#4": 3, "G#4": 4, "A#4": 5,
    "C#5": 7, "D#5": 8, "F#5": 10, "G#5": 11, "A#5": 12,
}

white_key_width, white_key_height = 56, 240
black_key_width, black_key_height = 34, 140
start_x = (WIDTH - (len(WHITE_NOTES) * white_key_width)) // 2
start_y = 210

white_rects = [(note, pygame.Rect(start_x + i * white_key_width, start_y, white_key_width - 2, white_key_height)) for i, note in enumerate(WHITE_NOTES)]
black_rects = [(note, pygame.Rect(start_x + (idx + 1) * white_key_width - (black_key_width // 2), start_y, black_key_width, black_key_height)) for note, idx in BLACK_POSITIONS.items()]

# Геометрия слайдера громкости
slider_rect = pygame.Rect(680, 45, 180, 10)
dragging_slider = False

# Шрифты
font_small = pygame.font.SysFont("Segoe UI", 12)
font_info = pygame.font.SysFont("Segoe UI", 15)
font_title = pygame.font.SysFont("Segoe UI", 22, bold=True)

active_notes = set()
clock = pygame.time.Clock()
running = True

def play_note(note):
    snd = sounds[note]
    snd.set_volume(volume)
    snd.play()

while running:
    mouse_pos = pygame.mouse.get_pos()
    mouse_pressed = pygame.mouse.get_pressed()[0]

    current_mouse_note = None

    # Обработка перетаскивания ползунка громкости
    if dragging_slider:
        if mouse_pressed:
            relative_x = max(0, min(mouse_pos[0] - slider_rect.x, slider_rect.width))
            volume = round(relative_x / slider_rect.width, 2)
        else:
            dragging_slider = False

    # Проверка нажатий мыши по клавишам (если не тащим слайдер)
    if mouse_pressed and not dragging_slider:
        for note, rect in black_rects:
            if rect.collidepoint(mouse_pos):
                current_mouse_note = note
                break
        if not current_mouse_note:
            for note, rect in white_rects:
                if rect.collidepoint(mouse_pos):
                    current_mouse_note = note
                    break

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

        elif event.type == pygame.MOUSEBUTTONDOWN:
            if event.button == 1:
                # Нажатие на область слайдера
                knob_x = slider_rect.x + int(volume * slider_rect.width)
                knob_rect = pygame.Rect(knob_x - 8, slider_rect.y - 5, 16, 20)
                if slider_rect.inflate(10, 20).collidepoint(event.pos):
                    dragging_slider = True
                    relative_x = max(0, min(event.pos[0] - slider_rect.x, slider_rect.width))
                    volume = round(relative_x / slider_rect.width, 2)

        elif event.type == pygame.KEYDOWN:
            if event.key == pygame.K_ESCAPE:
                running = False
            # Регулировка громкости с клавиатуры (+ / -)
            elif event.key in (pygame.K_PLUS, pygame.K_EQUALS, pygame.K_KP_PLUS):
                volume = min(1.0, round(volume + 0.05, 2))
            elif event.key in (pygame.K_MINUS, pygame.K_KP_MINUS):
                volume = max(0.0, round(volume - 0.05, 2))

            note = KEY_MAP_WHITE.get(event.key) or KEY_MAP_BLACK.get(event.key)
            if note and note not in active_notes:
                active_notes.add(note)
                play_note(note)

        elif event.type == pygame.KEYUP:
            note = KEY_MAP_WHITE.get(event.key) or KEY_MAP_BLACK.get(event.key)
            if note in active_notes:
                active_notes.remove(note)

    pressed_now = set(active_notes)
    if current_mouse_note:
        if current_mouse_note not in active_notes:
            play_note(current_mouse_note)
        pressed_now.add(current_mouse_note)

    # Отрисовка
    screen.fill(BG_COLOR)

    # Текст
    title_text = font_title.render("Функціональне піаніно на Python 🎹", True, (240, 240, 240))
    info1 = font_info.render("Клавіатура: A S D F G H J K L (білі), W E T Y U O P (чорні)", True, TEXT_COLOR)
    info2 = font_info.render("Гучність: +/- або повзунок мишею | Esc - вихід", True, TEXT_COLOR)

    screen.blit(title_text, (30, 25))
    screen.blit(info1, (30, 70))
    screen.blit(info2, (30, 95))

    # Отрисовка слайдера громкости
    vol_label = font_info.render(f"Гучність: {int(volume * 100)}%", True, TEXT_COLOR)
    screen.blit(vol_label, (slider_rect.x, slider_rect.y - 25))

    pygame.draw.rect(screen, SLIDER_BG, slider_rect, border_radius=5)
    filled_rect = pygame.Rect(slider_rect.x, slider_rect.y, int(slider_rect.width * volume), slider_rect.height)
    pygame.draw.rect(screen, SLIDER_FILL, filled_rect, border_radius=5)

    knob_x = slider_rect.x + int(volume * slider_rect.width)
    pygame.draw.circle(screen, SLIDER_KNOB, (knob_x, slider_rect.centery), 8)

    # Клавиши
    for note, rect in white_rects:
        color = WHITE_KEY_PRESSED if note in pressed_now else WHITE_KEY_COLOR
        pygame.draw.rect(screen, color, rect, border_radius=6)
        pygame.draw.rect(screen, (160, 160, 170), rect, 1, border_radius=6)
        txt = font_small.render(note, True, KEY_TEXT_COLOR)
        screen.blit(txt, (rect.x + (rect.width - txt.get_width()) // 2, rect.bottom - 22))

    for note, rect in black_rects:
        color = BLACK_KEY_PRESSED if note in pressed_now else BLACK_KEY_COLOR
        pygame.draw.rect(screen, color, rect, border_radius=4)
        pygame.draw.rect(screen, (50, 50, 60), rect, 1, border_radius=4)
        txt = font_small.render(note, True, BLACK_KEY_TEXT_COLOR)
        screen.blit(txt, (rect.x + (rect.width - txt.get_width()) // 2, rect.bottom - 22))

    pygame.display.flip()
    clock.tick(60)

pygame.quit()
sys.exit()